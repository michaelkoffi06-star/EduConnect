{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit)",
      "Bash(npx prisma generate)",
      "Bash(npm run build)"
    ],
    "ask": [
      "Bash(npx prisma db push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git am *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(npx prisma migrate *)",
      "Bash(prisma migrate *)",
      "Bash(npx prisma db push *--force-reset*)",
      "Bash(npx prisma db push *--accept-data-loss*)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(create-admin-user.js)"
    ]
  }
}
