// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Catégories d'instructeurs
enum InstructorType {
  ETUDIANT
  PROF_COLLEGE
  PROF_LYCEE
  REPETITEUR_PROFESSIONNEL
}

// 2. Statut pour la modération des inscriptions
enum ProfileStatus {
  PENDING
  APPROVED
  SUSPENDED
}

// 3. Niveaux d'enseignement pris en charge
enum AcademicLevel {
  PRIMAIRE
  COLLEGE
  LYCEE
  ALL
}

// 3bis. Mode d'enseignement proposé par l'instructeur
enum TeachingMode {
  DOMICILE
  EN_LIGNE
  LES_DEUX
}

// 4. Statut de traitement des messages de contact du site
enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

// 5. Table principale : Les Instructeurs
model Instructor {
  id          String         @id @default(uuid())
  firstName   String
  lastName    String
  type        InstructorType @default(ETUDIANT)
  status      ProfileStatus  @default(PENDING)
  levels      AcademicLevel  @default(ALL)
  mode        TeachingMode   @default(DOMICILE)
  city        String?
  commune     String?
  bio         String?        @db.Text
  photoUrl    String?
  cniUrl      String?
  cvUrl       String?
  editToken   String         @unique @default(uuid()) // Lien secret d'auto-edition du profil
  email       String         @unique
  whatsapp    String
  rating      Float?
  ratingCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subjects        InstructorSubject[]
  matchRequests   MatchRequest[]
  contracts       Contract[]
  user            User? // Compte de connexion de l'instructeur (espace instructeur, voir §7quindecies)
  marketInterests MarketInterest[]
}

// 6. Table des Disciplines (Maths, Physique...)
model Subject {
  id    String  @id @default(uuid())
  name  String  @unique
  slug  String  @unique
  color String? // Couleur des tranches de la matière sur l'étagère de la bibliothèque (hex, ex. #8FB3AB)

  instructors  InstructorSubject[]
  resources    Resource[]
  contracts    Contract[]
  chapters     Chapter[]
  marketOffers MarketOffer[]
  forumThreads ForumThread[]
}

// 7. Table de liaison explicite Many-to-Many
model InstructorSubject {
  instructorId String
  subjectId    String

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  subject    Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([instructorId, subjectId])
}

// 8. Messages envoyés depuis le formulaire de contact général du site
model ContactMessage {
  id        String        @id @default(uuid())
  fullName  String
  email     String
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// 9. Statut de traitement d'une demande de mise en relation
enum MatchStatus {
  NEW
  CONTACTED
  DONE
}

// 10. Demande d'un parent/élève : "je veux cet instructeur".
model MatchRequest {
  id             String      @id @default(uuid())
  studentEmail   String
  studentMessage String      @db.Text
  instructorId   String
  instructorName String
  status         MatchStatus @default(NEW)
  createdAt      DateTime    @default(now())

  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

// 11. Suggestions / retours des utilisateurs sur la plateforme
model Feedback {
  id        String        @id @default(uuid())
  message   String        @db.Text
  email     String?
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
}

// 12. Journal des tentatives de connexion admin échouées (protection anti-bruteforce)
model LoginAttempt {
  id        String   @id @default(uuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String
  subjectId String
  createdAt DateTime @default(now())

  @@index([subjectId])
}

// 14. Type de contenu pédagogique de la bibliothèque
enum ResourceType {
  DOCUMENT
  VIDEO
  EXERCICE
  LIEN
}

// 15. Bibliothèque de contenus éducatifs (documents, vidéos, exercices, liens)
model Resource {
  id            String        @id @default(uuid())
  title         String
  slug          String?       @unique // URL publique /bibliotheque/<slug> ; null pour les ressources créées avant la v2 (on retombe alors sur l'id)
  description   String?       @db.Text
  type          ResourceType
  subjectId     String
  chapterId     String? // Classeur (chapitre) auquel appartient la ressource ; optionnel
  position      Int           @default(0) // Ordre d'affichage des onglets dans le classeur
  level         AcademicLevel @default(ALL)
  fileUrl       String? // DOCUMENT / EXERCICE : fichier hébergé sur R2
  externalUrl   String? // VIDEO / LIEN : URL externe (YouTube, Vimeo, etc.)
  refNumber     Int           @unique @default(autoincrement()) // Sert à construire le code de référence affiché (ex. MATH-3E-07-C)
  viewCount     Int           @default(0)
  downloadCount Int           @default(0)
  createdAt     DateTime      @default(now())

  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  correction Correction? // Corrigé réservé aux comptes connectés (voir §7quindecies)

  @@index([subjectId])
  @@index([chapterId])
}

// 15bis. Chapitres de la bibliothèque : chaque chapitre est un "classeur" qui regroupe
// les ressources d'une matière pour un niveau/une classe (cours, exercices, vidéos, liens).
model Chapter {
  id        String        @id @default(uuid())
  title     String
  slug      String
  subjectId String
  level     AcademicLevel
  classe    String? // Classe précise, texte libre (ex. "3e", "Tle D", "CM2")
  order     Int           @default(0) // Ordre d'affichage dans la matière
  createdAt DateTime      @default(now())

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  resources Resource[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

// 16. Rôles des comptes admin
enum AdminRole {
  SUPER_ADMIN
  PEDAGOGIE
  ADMINISTRATIF
}

// 17. Comptes admin (remplace le mot de passe unique partagé)
model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         AdminRole
  // Incrémenté à chaque changement de mot de passe ou de rôle : les sessions déjà ouvertes
  // (qui portent l'ancienne valeur) sont refusées immédiatement (voir §7sedecies)
  sessionVersion Int      @default(0)
  createdAt    DateTime  @default(now())
}

// 18. Un engagement instructeur : matière + niveau enseignés dans le cadre d'un suivi
model Contract {
  id           String        @id @default(uuid())
  instructorId String
  subjectId    String
  level        AcademicLevel
  createdAt    DateTime      @default(now())

  instructor Instructor      @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  subject    Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  entries    ContractEntry[]

  @@index([instructorId])
}

// 19. Historique mensuel d'un contrat : élèves, séances, montant reçu
model ContractEntry {
  id             String   @id @default(uuid())
  contractId     String
  month          DateTime
  studentCount   Int
  sessionCount   Int
  amountReceived Float
  createdAt      DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, month])
}

// ---------------------------------------------------------------------------
// Comptes utilisateurs, corrigés, marché des instructeurs et forum (voir §7quindecies)
// ---------------------------------------------------------------------------

// 20. Profil d'un compte utilisateur du site (distinct des comptes admin)
enum UserRole {
  ELEVE
  PARENT
  INSTRUCTEUR
}

// 21. Compte utilisateur : élève, parent ou instructeur (email + mot de passe)
model User {
  id              String    @id @default(uuid())
  email           String    @unique // Toujours enregistré en minuscules
  passwordHash    String
  role            UserRole
  firstName       String
  lastName        String
  classe          String? // Élève : classe suivie, texte libre (ex. "3e", "Tle D")
  emailVerifiedAt DateTime? // Connexion impossible tant que l'email n'est pas confirmé
  instructorId    String?   @unique // Compte INSTRUCTEUR : fiche instructeur liée (même email)
  sessionVersion  Int       @default(0) // Incrémenté au changement de mot de passe : déconnecte les autres sessions (§7sedecies)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  instructor   Instructor?   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  tokens       UserToken[]
  forumThreads ForumThread[]
  forumPosts   ForumPost[]
  forumReports ForumReport[]
}

// 22. Jetons à usage unique envoyés par email (confirmation d'adresse, mot de passe oublié)
enum UserTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model UserToken {
  id        String        @id @default(uuid())
  tokenHash String        @unique // SHA-256 du jeton : le jeton en clair n'existe que dans l'email
  type      UserTokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 23. Corrigé d'un document/exercice de la bibliothèque. Fichier stocké dans le bucket R2
// PRIVÉ (clé "corrections/<id>.<ext>"), servi uniquement aux comptes connectés via une URL signée.
model Correction {
  id            String   @id @default(uuid())
  resourceId    String   @unique // Un corrigé par document
  fileExt       String // pdf / jpg / png
  viewCount     Int      @default(0)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

// 24. Statut d'une annonce du marché des instructeurs
enum MarketOfferStatus {
  OPEN // Visible par les instructeurs, qui peuvent se positionner
  FILLED // Pourvue (un instructeur a été retenu)
  CLOSED // Retirée sans suite
}

// 25. Annonce du marché : besoin d'une famille, publié anonymement par l'équipe
model MarketOffer {
  id          String            @id @default(uuid())
  title       String
  subjectId   String
  level       AcademicLevel
  classe      String?
  mode        TeachingMode      @default(DOMICILE)
  city        String?
  commune     String?
  schedule    String? // Rythme / créneaux, texte libre (ex. "2 séances par semaine, le soir")
  budget      String? // Rémunération indicative, texte libre
  description String?           @db.Text
  status      MarketOfferStatus @default(OPEN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  interests MarketInterest[]

  @@index([status, createdAt])
}

// 26. Statut d'une candidature d'instructeur sur une annonce
enum MarketInterestStatus {
  PENDING
  SELECTED
  DECLINED
}

// 27. Un instructeur se déclare intéressé par une annonce
model MarketInterest {
  id           String               @id @default(uuid())
  offerId      String
  instructorId String
  message      String?              @db.Text
  status       MarketInterestStatus @default(PENDING)
  createdAt    DateTime             @default(now())

  offer      MarketOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  instructor Instructor  @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([offerId, instructorId])
  @@index([instructorId])
}

// 28. Espaces du forum
enum ForumSpace {
  QUESTIONS // Questions des élèves et parents, réponses de tous (lecture publique)
  SALLE_DES_PROFS // Entre instructeurs approuvés uniquement
}

// 29. Sujet du forum (question + fil de réponses)
model ForumThread {
  id             String         @id @default(uuid())
  space          ForumSpace     @default(QUESTIONS)
  title          String
  body           String         @db.Text
  subjectId      String?
  level          AcademicLevel?
  authorId       String
  hidden         Boolean        @default(false) // Masqué par la modération
  replyCount     Int            @default(0) // Réponses visibles
  lastActivityAt DateTime       @default(now())
  createdAt      DateTime       @default(now())

  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  posts   ForumPost[]
  reports ForumReport[]

  @@index([space, lastActivityAt])
}

// 30. Réponse dans un sujet du forum
model ForumPost {
  id        String   @id @default(uuid())
  threadId  String
  authorId  String
  body      String   @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())

  thread  ForumThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports ForumReport[]

  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

// 31. Signalement d'un sujet ou d'une réponse, traité par l'équipe
model ForumReport {
  id         String   @id @default(uuid())
  threadId   String
  postId     String? // null : c'est le sujet lui-même qui est signalé
  reporterId String
  reason     String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  thread   ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  post     ForumPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([resolved, createdAt])
}
